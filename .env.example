# Copy to .env and fill in real values. Never commit .env itself.
# Vite only exposes VITE_-prefixed vars to client code (baked in at build time, not
# runtime-read) — see https://vite.dev/guide/env-and-mode.

# Deployed API Gateway base URL (Catalyst AppSail), no trailing slash.
# Browser → Gateway only (C8). Path stays GET /v1/accusedPersons/{id}:riskProfile.
# Local: point at the deployed Gateway (CORS allows localhost:5173).
# Slate: set the same name as an App Variable / build env for the client project.
VITE_API_GATEWAY_URL=https://api-gateway-service-50044031746.development.catalystappsail.in
