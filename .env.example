# Copy to .env and fill in real values. Never commit .env itself.
# Vite only exposes VITE_-prefixed vars to client code (baked in at build time, not
# runtime-read) — see https://vite.dev/guide/env-and-mode.

# Deployed API Gateway base URL (Catalyst AppSail), no trailing slash.
# Browser → Gateway only (C8). Path stays GET /v1/accusedPersons/{id}:riskProfile.
# Local DEV: Vite proxies same-origin /v1 → this URL (so localhost and 127.0.0.1 both work).
# Slate/prod: baked into the build; browser calls this host directly (CORS on Gateway).
VITE_API_GATEWAY_URL=https://api-gateway-service-50044031746.development.catalystappsail.in

# Demo role picker + bootstrap mint (D-080). Leave unset/false on Lane B Slate.
# Local Vite only: set true AND AUTH_ALLOW_DEV_MINT=true on Auth AppSail.
# VITE_ALLOW_DEV_MINT=false
