# Copy to .env and fill in real values. Never commit .env itself.
# Vite only exposes VITE_-prefixed vars to client code (baked in at build time, not
# runtime-read) - see https://vite.dev/guide/env-and-mode.

# Deployed API Gateway base URL (Catalyst AppSail), no trailing slash. Deliberately no
# localhost fallback here - DeployPathCheck refuses to run without this set, since the
# point of that page is proving the deployed path, not local dev.
VITE_API_GATEWAY_URL=

# Investigation Service base URL for Feature 1 risk lookup (C2), no trailing slash.
# Local C1: Investigation Service defaults to SERVER_PORT=8080 (application.yml). When
# Analytics also runs locally it uses 8082 — Investigation stays on 8080.
# Once Feature 1 is reachable via the deployed gateway, replace this with that URL —
# same flip as VITE_API_GATEWAY_URL after Section 5.
VITE_INVESTIGATION_SERVICE_URL=http://localhost:8080
